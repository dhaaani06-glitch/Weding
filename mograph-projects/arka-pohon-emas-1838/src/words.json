 ],
 "sentences": [
  {
   "start": 0.2,
   "end": 7.16,
   "text": "Pada zaman dahulu, di sebuah desa kecil yang dikelilingi hutan lebat, hiduplah seorang pemuda bernama Arka.",
   "w0": 0,
   "w1": 15
  },
  {
   "start": 8.16,
   "end": 12.28,
   "text": "Arka dikenal sebagai pemuda miskin yang selalu mengeluh tentang kehidupannya.",
   "w0": 16,
   "w1": 25
  },
  {
   "start": 13.16,
   "end": 15.82,
   "text": "Ia ingin menjadi kaya tanpa harus bekerja keras.",
   "w0": 26,
   "w1": 33
  },
  {
   "start": 16.94,
   "end": 23.22,
   "text": "Suatu hari, ketika mencari kayu bakar di hutan, Arka menemukan sebuah pohon tua yang sangat besar.",
   "w0": 34,
   "w1": 49
  },
  {
   "start": 24.3,
   "end": 28.78,
   "text": "Anehnya, pohon itu memiliki buah berwarna keemasan yang memancarkan cahaya.",
   "w0": 50,
   "w1": 59
  },
  {
   "start": 29.98,
   "end": 32.56,
   "text": "Tiba-tiba, terdengar suara dari dalam pohon.",
   "w0": 60,
   "w1": 65
  },
  {
   "start": 33.74,
   "end": 36.46,
   "text": "“Wahai pemuda, ambillah satu buah dariku.",
   "w0": 66,
   "w1": 71
  },
  {
   "start": 37.26,
   "end": 44.42,
   "text": "Apa pun yang kau inginkan akan menjadi kenyataan.” Arka terkejut, tetapi matanya langsung berbinar.",
   "w0": 72,
   "w1": 85
  },
  {
   "start": 45.44,
   "end": 52.4,
   "text": "“Aku ingin emas sebanyak-banyaknya!” Seketika, buah itu jatuh dan berubah menjadi tumpukan emas di hadapannya.",
   "w0": 86,
   "w1": 100
  },
  {
   "start": 53.38,
   "end": 54.8,
   "text": "Arka tertawa kegirangan.",
   "w0": 101,
   "w1": 103
  },
  {
   "start": 55.48,
   "end": 63.16,
   "text": "Ia membawa emas tersebut pulang dan membeli rumah besar, pakaian mewah, serta segala sesuatu yang selama ini diimpikannya.",
   "w0": 104,
   "w1": 121
  },
  {
   "start": 64.36,
   "end": 66.54,
   "text": "Namun, keserakahannya tidak berhenti di situ.",
   "w0": 122,
   "w1": 127
  },
  {
   "start": 67.34,
   "end": 69.84,
   "text": "Keesokan harinya, ia kembali ke pohon ajaib.",
   "w0": 128,
   "w1": 134
  },
  {
   "start": 70.72,
   "end": 76.58,
   "text": "“Aku ingin emas sepuluh kali lebih banyak!” Pohon itu menjawab, “Kekayaanmu sudah cukup.",
   "w0": 135,
   "w1": 147
  },
  {
   "start": 77.12,
   "end": 84.64,
   "text": "Bukankah sebaiknya kau belajar bersyukur?” Arka marah dan mengancam akan menebang pohon itu jika keinginannya tidak dikabulkan.",
   "w0": 148,
   "w1": 164
  },
  {
   "start": 85.82,
   "end": 88.56,
   "text": "Akhirnya, pohon itu memberikan satu buah terakhir.",
   "w0": 165,
   "w1": 171
  },
  {
   "start": 89.72,
   "end": 95.36,
   "text": "Namun, ketika Arka membukanya, seluruh emas yang dimilikinya tiba-tiba berubah menjadi daun kering.",
   "w0": 172,
   "w1": 184
  },
  {
   "start": 96.26,
   "end": 97.6,
   "text": "Ia berteriak ketakutan.",
   "w0": 185,
   "w1": 187
  },
  {
   "start": 98.64,
