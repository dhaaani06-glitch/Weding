{
  "name": "voynann-mograph-starter",
  "version": "1.7.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "check-env": "node scripts/check-env.mjs",
    "prepare-vo": "node scripts/prepare-voiceover.mjs",
    "align": "node scripts/align.mjs",
    "brand": "node scripts/brand.mjs",
    "score": "node scripts/score-bed.mjs",
    "auto-duck": "node scripts/auto-duck.mjs",
    "audio-qc": "node scripts/audio-qc.mjs",
    "render": "node scripts/render-safe.mjs",
    "stills": "node scripts/stills.mjs",
    "kit-preview": "node scripts/stills.mjs --comp=KitGallery out/kit 3.5 7.5 11.5 15.5 19.5 23.5 27.5",
    "kit-preview-wide": "node scripts/stills.mjs --comp=KitGalleryWide out/kit-wide 3.5 7.5 11.5 15.5 19.5 23.5 27.5",
    "style-preview": "node scripts/stills.mjs --comp=StyleGallery out/styles 2.6 3.6 6.6 7.6 10.6 11.6 14.6 15.6 18.6 19.6 22.6 23.6 26.6 27.6 30.6 31.6 34.6 35.6 38.6 39.6 42.6 43.6 46.6 47.6 50.6 51.6 54.6 55.6 58.6 59.6 62.6 63.6",
    "style-preview-wide": "node scripts/stills.mjs --comp=StyleGalleryWide out/styles-wide 2.6 3.6 6.6 7.6 10.6 11.6 14.6 15.6 18.6 19.6 22.6 23.6 26.6 27.6 30.6 31.6 34.6 35.6 38.6 39.6 42.6 43.6 46.6 47.6 50.6 51.6 54.6 55.6 58.6 59.6 62.6 63.6",
    "style-sfx": "node scripts/style-sound.mjs sfx",
    "style-score": "node scripts/style-sound.mjs score",
    "make-map": "node scripts/make-map.mjs",
    "sync-check": "node scripts/sync-check.mjs"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.534",
    "@remotion/cli": "4.0.534",
    "@remotion/renderer": "4.0.534",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "typescript": "5.9.2"
  }
}
